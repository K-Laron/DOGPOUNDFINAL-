# ===========================================
# Catarman Dog Pound Management System
# Environment Configuration Template
# ===========================================
#
# INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. Fill in your actual values
# 3. NEVER commit .env to version control!
#
# ===========================================

# Application Environment
# Options: development, production
APP_ENV=development

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=catarman_dog_pound_db
DB_USER=root
DB_PASS=

# ===========================================
# JWT CONFIGURATION
# ===========================================
# Generate a secure 64-character key for production:
# php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=your-secure-jwt-secret-key-change-this-in-production

# ===========================================
# SECURITY CONFIGURATION
# ===========================================

# Set to 'true' if behind a reverse proxy (Nginx, Cloudflare, etc.)
# This allows rate limiter to read X-Forwarded-For headers
TRUSTED_PROXY=false

# CORS allowed origins (comma-separated)
# Leave empty for development (allows localhost)
# For production: CORS_ORIGINS=https://yourdomain.com
# CORS_ORIGINS=

# ===========================================
# URL CONFIGURATION (Optional)
# ===========================================
# BASE_URL=http://localhost:8000
# FRONTEND_URL=http://localhost:3000
